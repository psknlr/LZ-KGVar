46],[15,329],[13,311]],"top_witnesses":[{"id":"DZ0699","title":"道德會元","events":769,"run_instances":64},{"id":"7640267984686022708","title":"音註河上公老子道德經","events":579,"run_instances":73},{"id":"SK2151","title":"老子河上公注","events":567,"run_instances":74},{"id":"7489388580045848603","title":"老子通義","events":562,"run_instances":57},{"id":"SK2157","title":"老子翼","events":560,"run_instances":78},{"id":"SBCK106","title":"老子道德經","events":557,"run_instances":75},{"id":"DZ0665","title":"道德經古本篇","events":514,"run_instances":70},{"id":"DZ0689","title":"道德真經論","events":512,"run_instances":71},{"id":"ZHXDZ082","title":"老子本義","events":439,"run_instances":61},{"id":"ZHXDZ054","title":"老子道德經參補","events":433,"run_instances":57},{"id":"ZWDS0299","title":"老子道德經","events":419,"run_instances":78},{"id":"DZ0680","title":"宋徽宗御解道德真經","events":399,"run_instances":81},{"id":"DZ0682","title":"道德真經注","events":394,"run_instances":51},{"id":"7489099792547577906","title":"老子解","events":391,"run_instances":73},{"id":"HY1408","title":"老子道德經","events":385,"run_instances":80}],"explanations":[{"pair":["唯","惟"],"rows":181,"text":"①「唯」为语气词，表应诺；「惟」兼语气词与助词，意义略宽。②在《老子》「唯之与阿」等句中，二字音义相通，替换不影响语义。③学界视为文字通假，无义项差异。","ops":{"replace":181},"types":{"字形层":181}},{"pair":["德","徳"],"rows":86,"text":"①「德」为正体，下从「心」符，示「心得、行正」；「徳」乃异体，省「心」为「彳」旁之变写，多见于古写卷及日本汉字。②二者音义全同，替换后不影响「道」「德」之哲学内涵，帛书乙本、郭店楚简本中亦偶见省心之写法。③学界多据字形演变视「徳」为「德」之古体或书写异文，高明、池田知久等均指出此乃抄手习惯所致，不关义理。","ops":{"replace":86},"types":{"字形层":86}},{"pair":["若","如"],"rows":58,"text":"①「若」本义为「顺从、允诺」，引申有「如同、像」之义；「如」本义为「遵从」，亦有「如同」之义，二者在「像、似」义上完全相通。②在《老子》中「若」「如」多用于比喻句（如「上善若水」/「上善如水」），互换后文义无别，皆表譬喻关系。③学界普遍视此为通假互用，王弼本、帛书甲乙本及郭店楚简本用字不一，反映不同传写系统的习惯差异，不构成思想分歧。","ops":{"replace":58},"types":{"字形层":58}},{"pair":["人","民"],"rows":55,"text":"①帛书本及部分版本作「人」，传世本多作「民」。②「民/人不争」「圣人/民」的替换，直接影响文本是政治论还是普遍人性论的解读方向。③高明等认为「民」含政治意涵，「人」更中性，帛书版本中「人」出现频率明显高于传世本。","ops":{"replace":55},"types":{"字形层":55}},{"pair":["居","处"],"rows":50,"text":"①「居」侧重定居、安处，带有安稳、停留之义；「处」泛指所在、置身，语义范围更广。②二者用于《老子》安身立命之语境（如「君子居」「圣人处」），互换后基本不影响哲学义涵，惟「居」稍含「安居」之意。③学界一般视此为同义换用，王弼本与帛书本在「居」「处」间常有出入，反映抄写者的语词习惯，不具实质义理差别。","ops":{"replace":50},"types":{"字形层":50}},{"pair":["棁","锐"],"rows":42,"text":"①「棁」（zhuō）字本指棺木钉或犁铧，字形生僻；「锐」（ruì）字形声明晰，本义为「锋利」。二字字形、字义本不相涉。②第九章「揣而棁之，不可长保」，若作「锐」则文从字顺，喻削磨使锋利而易折；若作「棁」则须视为借字，文义略晦。③学界多从王念孙、朱谦之说，主张「棁」即「锐」之通假字，盖古音相近而传写致误；亦有学者据河上公注「治其锤锻」释为「锻磨」之义。","ops":{"replace":42},"types":{"字形层":42}},{"pair":["恒","常"],"rows":3,"text":"①「恒」见于帛书甲乙本，「常」见于传世王弼本；因汉文帝刘恒讳，传抄中「恒」被改为「常」。②「恒道」强调绝对永恒性，「常道」侧重规律性，语义存在细微差别。③学界（高明、陈鼓应等）普遍据帛书认为「恒」为本字，「常」为避讳改字。","ops":{"replace":3},"types":{"字形层":3}}],"reference":{"reference_text_id":"WANGBI_CANONICAL","reference_version_id":"WANGBI_TONGSHI_2026","detection_method":["difflib_char_diff_v1.0.0"],"variant_status":["candidate_auto_detected"]},"change_type_zh":{"词汇层":"词汇层","字形层":"字形层","句法层":"句法层"},"edit_op_zh":{"insert":"增","delete":"删","replace":"改"},"composition_zh":{"mixed":"经注混合","commentary_dominant":"注文为主","scripture_dominant":"经文为主","unknown":"未知"}}