ebca36e8-b2d3-4053-91fd-f27bd4fafb15",0,"B",1.0,true,15]]],"215f074c-6100-4d05-b7ef-829590e3367e":["WANGBI_TONGSHI_2026","WANGBI_TONGSHI_2026-CH071",71,"de","王弼（通释整理本）","","","现代",0,true,"C","minimax-m3","本章优先扣合的主线是：圣德与政治",0,16,"",[["0e51089b-760f-4243-9350-92c7cad1aa84",0,"C",1.0,true,16]]],"0f409881-ef6f-43c4-8c17-8b9fe70d7916":["WANGBI_TONGSHI_2026","WANGBI_TONGSHI_2026-CH071",71,"ziran","王弼（通释整理本）","","","现代",0,true,"C","minimax-m3","纳入有无、本末、名言、自然与政治的网络",0,19,"",[["b96f9d3a-4aa5-4165-ac69-7de70894f8f6",0,"C",1.0,true,19]]],"fde7146e-c646-41d8-9ee9-809f8b32ef63":["WANGBI_TONGSHI_2026","WANGBI_TONGSHI_2026-CH071",71,"wu","王弼（通释整理本）","","","现代",0,true,"C","minimax-m3","纳入有无、本末、名言、自然与政治的网络",0,19,"",[["6a11bcfe-76ba-4265-8112-b7c8b03d3bf6",0,"C",1.0,true,19]]],"910ad4ca-208d-40da-99ce-58f2f2205ef3":["WANGBI_TONGSHI_2026","WANGBI_TONGSHI_2026-CH071",71,"you","王弼（通释整理本）","","","现代",0,true,"C","minimax-m3","纳入有无、本末、名言、自然与政治的网络",0,19,"",[["a1ddccbe-c720-4611-bffc-6516c5cefb91",0,"C",1.0,true,19]]],"9ad97f21-3927-451f-997c-19cacbb039b9":["WANGBI_TONGSHI_2026","WANGBI_TONGSHI_2026-CH071",71,"ming","王弼（通释整理本）","","","现代",0,true,"C","minimax-m3","纳入有无、本末、名言、自然与政治的网络",0,19,"",[["4da147a7-c952-4069-b84d-4b0873ea1873",0,"C",1.0,true,19]]],"dfebe9d6-59af-47b7-93ce-78c9556fc30f":["WANGBI_TONGSHI_2026","WANGBI_TONGSHI_2026-CH071",71,"ext_46276","王弼（通释整理本）","","","现代",0,true,"C","minimax-m3","知不知，上；不知知，病。",0,12,"",[["c91425e2-636f-435c-ab67-e4a3aa10b0c7",0,"C",1.0,true,12]]],"bf707013-1ca2-4d8f-b3b1-3d3f1cfb8e0a":["ZHXDZ081","ZHXDZ081-CH071",71,"shengren","姚鼐撰","P_姚鼐","清","清",0,true,"C","llm_assisted_batch_v1","",0,18,"",[["5a22cf9c-37e2-4d03-b3b1-d727e9b08990",0,"C",1.0,true,18]]],"49605f06-f3b0-486a-9593-55e2659ead57":["ZHXDZ082","ZHXDZ082-CH071",71,"shengren","鄭環撰","P_鄭環","明","清",0,true,"B","llm_assisted_batch_v1","",0,33,"",[["86558e61-25f5-4189-8556-965515efb033",0,"B",1.0,true,33]]],"3a2e5b09-d0f0-4bdf-9adc-ee21fb720aa1":["ZWDS0300","ZWDS0300-CH071",71,"shengren","焦竑撰","P_JIAOHONG","明","明",0,true,"B","llm_assisted_batch_v1","",0,26,"",[["e6cbd4a2-f194-4272-8a52-5fe2a298b315",0,"B",1.0,true,26]]]},"wangbi":null,"profile":"public","expl":[{"pair":["唯","惟"],"text":"①「唯」为语气词，表应诺；「惟」兼语气词与助词，意义略宽。②在《老子》「唯之与阿」等句中，二字音义相通，替换不影响语义。③学界视为文字通假，无义项差异。","rows":181},{"pair":["德","徳"],"text":"①「德」为正体，下从「心」符，示「心得、行正」；「徳」乃异体，省「心」为「彳」旁之变写，多见于古写卷及日本汉字。②二者音义全同，替换后不影响「道」「德」之哲学内涵，帛书乙本、郭店楚简本中亦偶见省心之写法。③学界多据字形演变视「徳」为「德」之古体或书写异文，高明、池田知久等均指出此乃抄手习惯所致，不关义理。","rows":86},{"pair":["若","如"],"text":"①「若」本义为「顺从、允诺」，引申有「如同、像」之义；「如」本义为「遵从」，亦有「如同」之义，二者在「像、似」义上完全相通。②在《老子》中「若」「如」多用于比喻句（如「上善若水」/「上善如水」），互换后文义无别，皆表譬喻关系。③学界普遍视此为通假互用，王弼本、帛书甲乙本及郭店楚简本用字不一，反映不同传写系统的习惯差异，不构成思想分歧。","rows":58},{"pair":["人","民"],"text":"①帛书本及部分版本作「人」，传世本多作「民」。②「民/人不争」「圣人/民」的替换，直接影响文本是政治论还是普遍人性论的解读方向。③高明等认为「民」含政治意涵，「人」更中性，帛书版本中「人」出现频率明显高于传世本。","rows":55},{"pair":["居","处"],"text":"①「居」侧重定居、安处，带有安稳、停留之义；「处」泛指所在、置身，语义范围更广。②二者用于《老子》安身立命之语境（如「君子居」「圣人处」），互换后基本不影响哲学义涵，惟「居」稍含「安居」之意。③学界一般视此为同义换用，王弼本与帛书本在「居」「处」间常有出入，反映抄写者的语词习惯，不具实质义理差别。","rows":50},{"pair":["棁","锐"],"text":"①「棁」（zhuō）字本指棺木钉或犁铧，字形生僻；「锐」（ruì）字形声明晰，本义为「锋利」。二字字形、字义本不相涉。②第九章「揣而棁之，不可长保」，若作「锐」则文从字顺，喻削磨使锋利而易折；若作「棁」则须视为借字，文义略晦。③学界多从王念孙、朱谦之说，主张「棁」即「锐」之通假字，盖古音相近而传写致误；亦有学者据河上公注「治其锤锻」释为「锻磨」之义。","rows":42},{"pair":["恒","常"],"text":"①「恒」见于帛书甲乙本，「常」见于传世王弼本；因汉文帝刘恒讳，传抄中「恒」被改为「常」。②「恒道」强调绝对永恒性，「常道」侧重规律性，语义存在细微差别。③学界（高明、陈鼓应等）普遍据帛书认为「恒」为本字，「常」为避讳改字。","rows":3}],"codes":{"type":["词汇层","字形层","句法层"],"op":["insert","delete","replace"]}}