鄧錡","南宋","元",0,true,"B","llm_assisted_batch_v1","",0,21,"",[["2dfb3100-0912-4196-90be-066974cb8df0",0,"B",1.0,true,21]]],"62b5abfe-43a9-4422-8ed0-f3fccf975738":["DZ0710","DZ0710-CH012",12,"shengren","顧歡等人注","P_顧歡","南朝宋","南朝宋",0,true,"B","llm_assisted_batch_v1","",0,41,"",[["ceda45d5-c19a-406d-8746-b804f2b55cfe",0,"B",1.0,true,41]]],"895a9d76-e658-499e-90e5-0e10794c5750":["DZ0721","DZ0721-CH012",12,"shengren","息齋道人撰","P_息齋道人","北宋","南朝宋",0,true,"B","llm_assisted_batch_v1","",0,22,"",[["aec38c53-138b-493b-a183-c6a3203c03a0",0,"B",1.0,true,22]]],"ef85709a-168b-42d9-b7a6-561b906e324f":["HY0445","HY0445-CH012",12,"shengren","徐學謨徐學謨","P_XUXUEMO","明","清",1,false,"B","llm_assisted_batch_v1","",48,0,"",[["59e39379-c5a9-4922-80fb-a82fabbbb1e0",1,"B",1.0,false,48]]],"f3532790-dbc1-401c-aec3-22f24ad0f0fb":["WANGBI_TONGSHI_2026","WANGBI_TONGSHI_2026-CH012",12,"wu","王弼（通释整理本）","","","现代",0,true,"A","minimax-m3","无不是数量空缺，而是使有之利得以成立的条件与根据；有也不是可离根据的现成堆积。",0,39,"",[["ea9575c2-1849-49f4-835c-17633d8aadf9",0,"A",1.0,true,39]]],"f2e588f4-1a35-447f-b53e-8ec5b79bad65":["WANGBI_TONGSHI_2026","WANGBI_TONGSHI_2026-CH012",12,"you","王弼（通释整理本）","","","现代",0,true,"A","minimax-m3","无不是数量空缺，而是使有之利得以成立的条件与根据；有也不是可离根据的现成堆积。",0,39,"",[["65a05a1b-927e-4823-a9b1-f86f2ea8b0ea",0,"A",1.0,true,39]]],"c5cefe18-2fc0-4348-9d2e-7fe230433cb2":["WANGBI_TONGSHI_2026","WANGBI_TONGSHI_2026-CH012",12,"ziran","王弼（通释整理本）","","","现代",1,false,"A","minimax-m3","",48,0,"",[["6dc8c92c-2285-4652-845a-2d6f15df8f89",1,"A",1.0,false,48]]],"6960a9ff-1168-4a81-b2f4-c894163d99dc":["WANGBI_TONGSHI_2026","WANGBI_TONGSHI_2026-CH012",12,"wuwei","王弼（通释整理本）","","","现代",0,true,"A","minimax-m3","无为不是不动，而是不以私意与造作破坏事物自有之条件。",0,26,"",[["77a27987-3c9b-43cd-a666-90a370e034a4",0,"A",1.0,true,26]]],"0e34cc6b-2728-4791-8800-10fe2903d780":["WANGBI_TONGSHI_2026","WANGBI_TONGSHI_2026-CH012",12,"shengren","王弼（通释整理本）","","","现代",1,false,"A","minimax-m3","",55,0,"",[["8794ffe5-fda9-4847-ac8c-95b730ddacba",1,"A",1.0,false,55]]],"52a2fe9c-4749-4366-8155-01a2522d19cc":["WANGBI_TONGSHI_2026","WANGBI_TONGSHI_2026-CH012",12,"ming","王弼（通释整理本）","","","现代",0,true,"B","minimax-m3","可道可名进入指事造形之域，故非常；称谓可以指示，却不能把根据钉死为名物。",0,36,"",[["fbb3acce-1c25-45d3-bf97-8bc676cc6ab8",0,"B",1.0,true,36]]]},"wangbi":null,"profile":"public","expl":[{"pair":["唯","惟"],"text":"①「唯」为语气词，表应诺；「惟」兼语气词与助词，意义略宽。②在《老子》「唯之与阿」等句中，二字音义相通，替换不影响语义。③学界视为文字通假，无义项差异。","rows":181},{"pair":["德","徳"],"text":"①「德」为正体，下从「心」符，示「心得、行正」；「徳」乃异体，省「心」为「彳」旁之变写，多见于古写卷及日本汉字。②二者音义全同，替换后不影响「道」「德」之哲学内涵，帛书乙本、郭店楚简本中亦偶见省心之写法。③学界多据字形演变视「徳」为「德」之古体或书写异文，高明、池田知久等均指出此乃抄手习惯所致，不关义理。","rows":86},{"pair":["若","如"],"text":"①「若」本义为「顺从、允诺」，引申有「如同、像」之义；「如」本义为「遵从」，亦有「如同」之义，二者在「像、似」义上完全相通。②在《老子》中「若」「如」多用于比喻句（如「上善若水」/「上善如水」），互换后文义无别，皆表譬喻关系。③学界普遍视此为通假互用，王弼本、帛书甲乙本及郭店楚简本用字不一，反映不同传写系统的习惯差异，不构成思想分歧。","rows":58},{"pair":["人","民"],"text":"①帛书本及部分版本作「人」，传世本多作「民」。②「民/人不争」「圣人/民」的替换，直接影响文本是政治论还是普遍人性论的解读方向。③高明等认为「民」含政治意涵，「人」更中性，帛书版本中「人」出现频率明显高于传世本。","rows":55},{"pair":["居","处"],"text":"①「居」侧重定居、安处，带有安稳、停留之义；「处」泛指所在、置身，语义范围更广。②二者用于《老子》安身立命之语境（如「君子居」「圣人处」），互换后基本不影响哲学义涵，惟「居」稍含「安居」之意。③学界一般视此为同义换用，王弼本与帛书本在「居」「处」间常有出入，反映抄写者的语词习惯，不具实质义理差别。","rows":50},{"pair":["棁","锐"],"text":"①「棁」（zhuō）字本指棺木钉或犁铧，字形生僻；「锐」（ruì）字形声明晰，本义为「锋利」。二字字形、字义本不相涉。②第九章「揣而棁之，不可长保」，若作「锐」则文从字顺，喻削磨使锋利而易折；若作「棁」则须视为借字，文义略晦。③学界多从王念孙、朱谦之说，主张「棁」即「锐」之通假字，盖古音相近而传写致误；亦有学者据河上公注「治其锤锻」释为「锻磨」之义。","rows":42},{"pair":["恒","常"],"text":"①「恒」见于帛书甲乙本，「常」见于传世王弼本；因汉文帝刘恒讳，传抄中「恒」被改为「常」。②「恒道」强调绝对永恒性，「常道」侧重规律性，语义存在细微差别。③学界（高明、陈鼓应等）普遍据帛书认为「恒」为本字，「常」为避讳改字。","rows":3}],"codes":{"type":["词汇层","字形层","句法层"],"op":["insert","delete","replace"]}}