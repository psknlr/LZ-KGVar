tch_v1","",0,20,"",[["34a86913-d3ec-4303-a95d-f6a391f86377",0,"A",1.0,true,20]]],"560edcd7-0760-46ae-9201-c1c38e119f70":["SBCK106","SBCK106-CH026",26,"you","河上公注","P_HESHANGGONG","西汉","春秋战国",1,false,"B","llm_assisted_batch_v1","",29,0,"",[["c82cda08-1ed0-42e9-9169-75c80eea2f6a",1,"B",1.0,false,29]]],"058bcf0a-3177-43e9-92d7-eacd2b74d11a":["SK2151","SK2151-CH026",26,"dao","題河上公注","P_HESHANGGONG","西汉","清",2,false,"B","llm_assisted_batch_v1","",23,0,"",[["c3a81887-3a0b-43d6-9bbe-1574c23fc14a",2,"B",0.333,false,23]]],"db28e608-e7f1-4c27-9ce4-a1edb08326b3":["WANGBI_TONGSHI_2026","WANGBI_TONGSHI_2026-CH026",26,"wu","王弼（通释整理本）","","","现代",0,true,"A","minimax-m3","无不是数量空缺，而是使有之利得以成立的条件与根据；有也不是可离根据的现成堆积。",0,39,"",[["28c57bf1-d3e7-4cb2-8967-c2dcdbe43e48",0,"A",1.0,true,39]]],"dc712855-1101-469d-83bf-d8b35840d814":["WANGBI_TONGSHI_2026","WANGBI_TONGSHI_2026-CH026",26,"wu","王弼（通释整理本）","","","现代",0,true,"A","minimax-m3","无为不是不动，而是不以私意与造作破坏事物自有之条件。",0,26,"",[["84d8a520-de51-4bb3-b8cf-713061289238",0,"A",1.0,true,26]]],"6d8d71a4-c0c7-4324-b104-f485ccee8d4c":["WANGBI_TONGSHI_2026","WANGBI_TONGSHI_2026-CH026",26,"ming","王弼（通释整理本）","","","现代",0,true,"A","minimax-m3","可道可名进入指事造形之域，故非常；称谓可以指示，却不能把根据钉死为名物。",0,36,"",[["35b570d2-d84a-4468-a7bc-9951dad3fd9d",0,"A",1.0,true,36]]],"572f17f1-155f-478d-adc2-ec53cdbcfd77":["WANGBI_TONGSHI_2026","WANGBI_TONGSHI_2026-CH026",26,"shengren","王弼（通释整理本）","","","现代",0,true,"B","minimax-m3","圣人相关语句应回向治理中的自我限制，而不是现代政治口号的投影。",0,31,"",[["b328d852-151b-4f22-9a1e-32699427110e",0,"B",1.0,true,31]]],"0454ae37-6c03-4e7c-805c-b69e3b7c6c7a":["ZHXDZ052","ZHXDZ052-CH026",26,"you","朱得之撰","P_朱得之","明","明",1,false,"C","llm_assisted_batch_v1","",57,0,"",[["364456bc-4d3c-4b55-9e7e-53cf5ed7499e",1,"C",0.963,false,57]]]},"wangbi":null,"profile":"public","expl":[{"pair":["唯","惟"],"text":"①「唯」为语气词，表应诺；「惟」兼语气词与助词，意义略宽。②在《老子》「唯之与阿」等句中，二字音义相通，替换不影响语义。③学界视为文字通假，无义项差异。","rows":181},{"pair":["德","徳"],"text":"①「德」为正体，下从「心」符，示「心得、行正」；「徳」乃异体，省「心」为「彳」旁之变写，多见于古写卷及日本汉字。②二者音义全同，替换后不影响「道」「德」之哲学内涵，帛书乙本、郭店楚简本中亦偶见省心之写法。③学界多据字形演变视「徳」为「德」之古体或书写异文，高明、池田知久等均指出此乃抄手习惯所致，不关义理。","rows":86},{"pair":["若","如"],"text":"①「若」本义为「顺从、允诺」，引申有「如同、像」之义；「如」本义为「遵从」，亦有「如同」之义，二者在「像、似」义上完全相通。②在《老子》中「若」「如」多用于比喻句（如「上善若水」/「上善如水」），互换后文义无别，皆表譬喻关系。③学界普遍视此为通假互用，王弼本、帛书甲乙本及郭店楚简本用字不一，反映不同传写系统的习惯差异，不构成思想分歧。","rows":58},{"pair":["人","民"],"text":"①帛书本及部分版本作「人」，传世本多作「民」。②「民/人不争」「圣人/民」的替换，直接影响文本是政治论还是普遍人性论的解读方向。③高明等认为「民」含政治意涵，「人」更中性，帛书版本中「人」出现频率明显高于传世本。","rows":55},{"pair":["居","处"],"text":"①「居」侧重定居、安处，带有安稳、停留之义；「处」泛指所在、置身，语义范围更广。②二者用于《老子》安身立命之语境（如「君子居」「圣人处」），互换后基本不影响哲学义涵，惟「居」稍含「安居」之意。③学界一般视此为同义换用，王弼本与帛书本在「居」「处」间常有出入，反映抄写者的语词习惯，不具实质义理差别。","rows":50},{"pair":["棁","锐"],"text":"①「棁」（zhuō）字本指棺木钉或犁铧，字形生僻；「锐」（ruì）字形声明晰，本义为「锋利」。二字字形、字义本不相涉。②第九章「揣而棁之，不可长保」，若作「锐」则文从字顺，喻削磨使锋利而易折；若作「棁」则须视为借字，文义略晦。③学界多从王念孙、朱谦之说，主张「棁」即「锐」之通假字，盖古音相近而传写致误；亦有学者据河上公注「治其锤锻」释为「锻磨」之义。","rows":42},{"pair":["恒","常"],"text":"①「恒」见于帛书甲乙本，「常」见于传世王弼本；因汉文帝刘恒讳，传抄中「恒」被改为「常」。②「恒道」强调绝对永恒性，「常道」侧重规律性，语义存在细微差别。③学界（高明、陈鼓应等）普遍据帛书认为「恒」为本字，「常」为避讳改字。","rows":3}],"codes":{"type":["词汇层","字形层","句法层"],"op":["insert","delete","replace"]}}