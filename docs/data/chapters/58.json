",[["a9a09104-96f1-4d3c-a62d-4c00c2059904",1,"B",1.0,false,46]]],"ad099407-4ed4-4f7c-a0c6-90e184b31194":["SK2151","SK2151-CH058",58,"shengren","題河上公注","P_HESHANGGONG","西汉","清",1,false,"B","llm_assisted_batch_v1","",50,0,"",[["ca05806f-617f-4487-a3c6-8eb4dbd6e434",1,"B",1.0,false,50]]],"3720a3af-c204-4f9c-902c-6e56888c9fc6":["WANGBI_TONGSHI_2026","WANGBI_TONGSHI_2026-CH058",58,"wu","王弼（通释整理本）","","","现代",0,true,"A","minimax-m3","言善政治者，无形、无名、无事、无政可举。",0,20,"",[["d1c0af9b-6917-4f64-9769-8fe7a1c89cb5",0,"A",1.0,true,20]]],"ed7b7757-5faa-466a-86d8-b7feff1b99ad":["WANGBI_TONGSHI_2026","WANGBI_TONGSHI_2026-CH058",58,"ming","王弼（通释整理本）","","","现代",0,true,"B","minimax-m3","无形、无名、无事、无政可举。",0,14,"",[["2dfad072-63fb-4824-a811-43e441b749a2",0,"B",1.0,true,14]]],"8d37ba3a-5754-4c46-9cfd-50710fa307f8":["WANGBI_TONGSHI_2026","WANGBI_TONGSHI_2026-CH058",58,"you","王弼（通释整理本）","","","现代",0,true,"B","minimax-m3","本章优先扣合的主线是：有/无、本/末（母/子）、名/称/言。",0,30,"",[["7908e1b3-9ac8-4dab-8469-c937824a6411",0,"B",1.0,true,30]]],"f253de08-2d7e-44ac-8e1e-aa8ac9f59fff":["ZHXDZ052","ZHXDZ052-CH058",58,"shengren","朱得之撰","P_朱得之","明","明",1,false,"A","llm_assisted_batch_v1","",38,0,"",[["ece344f9-1110-4132-be7a-6a9d5ec9f762",1,"A",1.0,false,38]]],"f1cd51e4-a2fd-435c-8cd5-693eb5eb8636":["ZHXDZ082","ZHXDZ082-CH058",58,"shengren","鄭環撰","P_鄭環","明","清",1,false,"B","llm_assisted_batch_v1","",33,0,"",[["6d48f621-ec4f-4dd4-9831-11bc03fe32e9",1,"B",1.0,false,33]]],"7cfb6ccf-9bd7-4bd4-abee-72b312a9fb13":["ZWDS0047","ZWDS0047-CH058",58,"shengren","李贄撰","P_李贄","明","明",0,true,"B","llm_assisted_batch_v1","",0,41,"",[["db624826-aa6e-4291-8452-e0b9cbaf65d4",0,"B",1.0,true,41]]]},"wangbi":null,"profile":"public","expl":[{"pair":["唯","惟"],"text":"①「唯」为语气词，表应诺；「惟」兼语气词与助词，意义略宽。②在《老子》「唯之与阿」等句中，二字音义相通，替换不影响语义。③学界视为文字通假，无义项差异。","rows":181},{"pair":["德","徳"],"text":"①「德」为正体，下从「心」符，示「心得、行正」；「徳」乃异体，省「心」为「彳」旁之变写，多见于古写卷及日本汉字。②二者音义全同，替换后不影响「道」「德」之哲学内涵，帛书乙本、郭店楚简本中亦偶见省心之写法。③学界多据字形演变视「徳」为「德」之古体或书写异文，高明、池田知久等均指出此乃抄手习惯所致，不关义理。","rows":86},{"pair":["若","如"],"text":"①「若」本义为「顺从、允诺」，引申有「如同、像」之义；「如」本义为「遵从」，亦有「如同」之义，二者在「像、似」义上完全相通。②在《老子》中「若」「如」多用于比喻句（如「上善若水」/「上善如水」），互换后文义无别，皆表譬喻关系。③学界普遍视此为通假互用，王弼本、帛书甲乙本及郭店楚简本用字不一，反映不同传写系统的习惯差异，不构成思想分歧。","rows":58},{"pair":["人","民"],"text":"①帛书本及部分版本作「人」，传世本多作「民」。②「民/人不争」「圣人/民」的替换，直接影响文本是政治论还是普遍人性论的解读方向。③高明等认为「民」含政治意涵，「人」更中性，帛书版本中「人」出现频率明显高于传世本。","rows":55},{"pair":["居","处"],"text":"①「居」侧重定居、安处，带有安稳、停留之义；「处」泛指所在、置身，语义范围更广。②二者用于《老子》安身立命之语境（如「君子居」「圣人处」），互换后基本不影响哲学义涵，惟「居」稍含「安居」之意。③学界一般视此为同义换用，王弼本与帛书本在「居」「处」间常有出入，反映抄写者的语词习惯，不具实质义理差别。","rows":50},{"pair":["棁","锐"],"text":"①「棁」（zhuō）字本指棺木钉或犁铧，字形生僻；「锐」（ruì）字形声明晰，本义为「锋利」。二字字形、字义本不相涉。②第九章「揣而棁之，不可长保」，若作「锐」则文从字顺，喻削磨使锋利而易折；若作「棁」则须视为借字，文义略晦。③学界多从王念孙、朱谦之说，主张「棁」即「锐」之通假字，盖古音相近而传写致误；亦有学者据河上公注「治其锤锻」释为「锻磨」之义。","rows":42},{"pair":["恒","常"],"text":"①「恒」见于帛书甲乙本，「常」见于传世王弼本；因汉文帝刘恒讳，传抄中「恒」被改为「常」。②「恒道」强调绝对永恒性，「常道」侧重规律性，语义存在细微差别。③学界（高明、陈鼓应等）普遍据帛书认为「恒」为本字，「常」为避讳改字。","rows":3}],"codes":{"type":["词汇层","字形层","句法层"],"op":["insert","delete","replace"]}}