c34a2d1958":["DZ0710","DZ0710-CH047",47,"shengren","顧歡等人注","P_顧歡","南朝宋","南朝宋",1,false,"B","llm_assisted_batch_v1","",48,0,"",[["faced87a-78db-47b7-8f06-cd39f151f5ec",1,"B",1.0,false,48]]],"aa717ba3-6dab-4f37-ae4d-d8354b68ccd0":["HY0445","HY0445-CH047",47,"shengren","徐學謨徐學謨","P_XUXUEMO","明","清",0,true,"A","llm_assisted_batch_v1","",0,39,"",[["d9344239-14ec-4197-b28d-959f4007450c",0,"A",1.0,true,39]]],"a6bbeb4a-627e-4f79-a697-55dc9889cccd":["HY1408","HY1408-CH047",47,"dao","李耳撰、河上公章句、顧春輯","P_LAOZI","春秋","明",0,true,"B","llm_assisted_batch_v1","",0,25,"",[["8106d195-3e22-45d1-9b2d-5615ed928ba4",0,"B",1.0,true,25]]],"ab515bfa-45b0-4cd5-978c-f0560d5325c2":["SK2153","SK2153-CH047",47,"dao","王弼註","P_王弼","三国","清",1,false,"B","llm_assisted_batch_v1","",30,0,"",[["525f4385-3f82-476d-9486-fd9e3083acd9",1,"B",1.0,false,30]]],"3f38a200-0e52-455b-a2cd-c5b9bd134efa":["SK2153","SK2153-CH047",47,"shengren","王弼註","P_王弼","三国","清",1,false,"B","llm_assisted_batch_v1","",29,0,"",[["ef5e703d-b26d-433a-83e3-497332fdd478",1,"B",1.0,false,29]]],"c38eb776-e5a9-4f99-8893-81b2e208bf87":["WANGBI_TONGSHI_2026","WANGBI_TONGSHI_2026-CH047",47,"yi","王弼（通释整理本）","","","现代",1,false,"B","minimax-m3","",25,0,"",[["4759881f-f3aa-454e-944d-1a69259675cd",1,"B",1.0,false,25]]],"5239b867-8479-4f52-b625-20048b412974":["ZHXDZ036","ZHXDZ036-CH047",47,"dao","暂空著","","","清",0,true,"A","llm_assisted_batch_v1","",0,31,"",[["bcc656b3-31ae-4582-8e88-7f34e3389b72",0,"A",1.0,true,31]]],"a73033c5-32e6-46e3-b077-1b6ba6102095":["ZHXDZ036","ZHXDZ036-CH047",47,"wuwei","暂空著","","","清",0,true,"B","llm_assisted_batch_v1","",0,42,"",[["34ce2524-8beb-42bf-b2d7-ef8519843555",0,"B",1.0,true,42]]],"9b59d832-6c94-4e8b-ac5d-b1d8f819f6eb":["ZHXDZ047","ZHXDZ047-CH047",47,"dao","范應元撰","P_范應元","南宋","南朝宋",0,true,"B","llm_assisted_batch_v1","",0,31,"",[["83f9d7a1-0d6b-41c7-8bda-ba4356275f8b",0,"B",1.0,true,31]]]},"wangbi":null,"profile":"public","expl":[{"pair":["唯","惟"],"text":"①「唯」为语气词，表应诺；「惟」兼语气词与助词，意义略宽。②在《老子》「唯之与阿」等句中，二字音义相通，替换不影响语义。③学界视为文字通假，无义项差异。","rows":181},{"pair":["德","徳"],"text":"①「德」为正体，下从「心」符，示「心得、行正」；「徳」乃异体，省「心」为「彳」旁之变写，多见于古写卷及日本汉字。②二者音义全同，替换后不影响「道」「德」之哲学内涵，帛书乙本、郭店楚简本中亦偶见省心之写法。③学界多据字形演变视「徳」为「德」之古体或书写异文，高明、池田知久等均指出此乃抄手习惯所致，不关义理。","rows":86},{"pair":["若","如"],"text":"①「若」本义为「顺从、允诺」，引申有「如同、像」之义；「如」本义为「遵从」，亦有「如同」之义，二者在「像、似」义上完全相通。②在《老子》中「若」「如」多用于比喻句（如「上善若水」/「上善如水」），互换后文义无别，皆表譬喻关系。③学界普遍视此为通假互用，王弼本、帛书甲乙本及郭店楚简本用字不一，反映不同传写系统的习惯差异，不构成思想分歧。","rows":58},{"pair":["人","民"],"text":"①帛书本及部分版本作「人」，传世本多作「民」。②「民/人不争」「圣人/民」的替换，直接影响文本是政治论还是普遍人性论的解读方向。③高明等认为「民」含政治意涵，「人」更中性，帛书版本中「人」出现频率明显高于传世本。","rows":55},{"pair":["居","处"],"text":"①「居」侧重定居、安处，带有安稳、停留之义；「处」泛指所在、置身，语义范围更广。②二者用于《老子》安身立命之语境（如「君子居」「圣人处」），互换后基本不影响哲学义涵，惟「居」稍含「安居」之意。③学界一般视此为同义换用，王弼本与帛书本在「居」「处」间常有出入，反映抄写者的语词习惯，不具实质义理差别。","rows":50},{"pair":["棁","锐"],"text":"①「棁」（zhuō）字本指棺木钉或犁铧，字形生僻；「锐」（ruì）字形声明晰，本义为「锋利」。二字字形、字义本不相涉。②第九章「揣而棁之，不可长保」，若作「锐」则文从字顺，喻削磨使锋利而易折；若作「棁」则须视为借字，文义略晦。③学界多从王念孙、朱谦之说，主张「棁」即「锐」之通假字，盖古音相近而传写致误；亦有学者据河上公注「治其锤锻」释为「锻磨」之义。","rows":42},{"pair":["恒","常"],"text":"①「恒」见于帛书甲乙本，「常」见于传世王弼本；因汉文帝刘恒讳，传抄中「恒」被改为「常」。②「恒道」强调绝对永恒性，「常道」侧重规律性，语义存在细微差别。③学界（高明、陈鼓应等）普遍据帛书认为「恒」为本字，「常」为避讳改字。","rows":3}],"codes":{"type":["词汇层","字形层","句法层"],"op":["insert","delete","replace"]}}